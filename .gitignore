# Upstream's own ignore conventions, kept verbatim. Nothing above this line is
# ours, and nothing below it removes an upstream entry to make room for a
# fork-owned one. Mbed TLS ships a real top-level `.gitignore`; this first block
# is that file, unchanged.
#
# Random seed file created by test scripts and sample programs
seedfile
# MBEDTLS_PSA_INJECT_ENTROPY seed file created by the test framework
00000000ffffff52.psa_its
# Log files created by all.sh to reduce the logs in case a component runs
# successfully
quiet-make.*

# CMake build artifacts:
CMakeCache.txt
CMakeFiles
CTestTestfile.cmake
cmake_install.cmake
Testing
# CMake generates *.dir/ folders for in-tree builds (used by MSVC projects), ignore all of those:
*.dir/
# MSVC files generated by CMake:
/*.sln
/*.vcxproj
/*.filters

# Test coverage build artifacts:
Coverage
*.gcno
*.gcda
coverage-summary.txt

# generated by scripts/memory.sh
massif-*

# Eclipse project files
.cproject
.project
/.settings

# Unix-like build artifacts:
*.o
*.s

# MSVC build artifacts:
*.exe
*.pdb
*.ilk
*.lib

# Python build artifacts:
*.pyc

# CMake generates *.dir/ folders for in-tree builds (used by MSVC projects), ignore all of those:
*.dir/

# Microsoft CMake extension for Visual Studio Code generates a build directory by default
/build/

# Generated documentation:
/apidoc

# PSA Crypto compliance test repo, cloned by test_psa_compliance.py
/psa-arch-tests

# Editor navigation files:
/GPATH
/GRTAGS
/GSYMS
/GTAGS
/TAGS
/cscope*.out
/tags

# clangd compilation database
compile_commands.json
# clangd index files
/.cache/clangd/index/

# VScode folder to store local debug files and configurations
.vscode

# zig build artefacts (fork addition).
#
# These are directories rather than single files because a normal `zig build`
# creates them, and a normal `zig build` must not dirty the tree or leak into
# the package published from it. None of them is named in build.zig.zon
# `.paths`, so an ignored directory can never become part of the package.
#
# `*.a`, `*.so`, `*.o`, `*.s`, `*.lib`, `*.pdb`, `*.ilk` and `*.exe` are already
# in upstream's block above, which is why this one adds no archive pattern: the
# archives `zig build -Dlinkage=dynamic` emits into `zig-out/lib` are covered by
# the `zig-out/` entry and any stray object by upstream's `*.o`.
.zig-cache/
zig-out/
# Zig 0.16 fetches dependencies into a project-local directory. This package
# declares no dependencies, so this exists only so that a future one cannot
# commit a fetched tree.
zig-pkg/

# The consumer package builds inside this repository and has its own cache and
# output tree. It is ignored here as well so a build run from the repository
# root cannot commit it by accident.
consumer/.zig-cache/
consumer/zig-out/
consumer/zig-pkg/

# Nix and devenv working-tree artefacts (fork addition).
#
# `nix build` writes `result` (and `result-1`, `result-2`, ... on a rebuild)
# into the directory that asked for it, and `devenv` writes its resolved
# inputs and its state beside the project. None of them is named in build.zig.zon
# `.paths`, so an ignored path can never become part of the package either.
# `devenv.lock` and `flake.lock` are deliberately *not* here: they are real
# inputs, they belong to the driver, and ignoring them would be the wrong way
# to keep a build out of a commit.
result
result-*
.devenv/
.devenv.flake.nix
.devenv.flakes/
devenv.local.nix
.direnv/