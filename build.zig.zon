.{
    // Package id; dependents use the key "mbed-tls".
    .name = .mbed_tls,
    // Upstream library version, checked against build_info.h by build.zig.
    .version = "3.6.7",
    .fingerprint = 0xc6bca3feca8ae44a,
    .minimum_zig_version = "0.16.0",
    // No external Zig dependencies.
    .dependencies = .{},
    .paths = .{
        // Build graph and cross-test settings.
        "build.zig",
        "build.zig.zon",
        "cross-test.profile.sh",
        // Facade, translation header and target-config generator.
        "zig",
        // Vendored upstream source tree.
        "src",
        // Handshake test fixtures.
        "fixtures",
        // Test and smoke roots.
        "tests.zig",
        "smoke.zig",
        // Separate consumer package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Upstream README under its original text.
        "README.upstream.md",
        // Fork provenance and licence records.
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "README.md",
        "README.zig.md",
        "NOTICE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "FORK-LICENSE.md",
        // Integrity-check tools.
        "tools",
        // Runtime-loading dispatch sources.
        "runtime",
        // Nix, devenv and direnv entry points.
        "package.nix",
        "flake.nix",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // Driver-owned locks and build outputs are excluded.
    },
}
